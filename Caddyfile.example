{
	email you@example.com
}

reviews-demo.hossammostafa.ai {
	# Everything needs the password. The public, shareable page with the link preview is
	# reviews.hossammostafa.ai, served from Cloudflare (see wrangler.site.jsonc).
	basic_auth {
		demo PASTE_THE_HASH_HERE
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:80 {
		header_up -Authorization
	}
}
