# application configuration
APPLICATION_NAME=reviews-analysis
APPLICATION_VERSION=0.1.0
APPLICATION_LOG_LEVEL=INFO

# llama-server (OpenAI-compatible)
# docker: http://llamacpp:8000/v1   local dev: http://localhost:8000/v1
OPENAI_API_KEY=not-needed
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_MODEL_NAME=local
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_COMPLETION_TOKENS=1024
OPENAI_SEED=42
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2

# performance configuration (keep equal to llamacpp --parallel)
PERFORMANCE_OPENAI_CONCURRENT_REQUESTS=4

# langfuse cloud (leave keys empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# sessions
SESSION_TTL_HOURS=6
SESSION_MAX_UPLOAD_MB=10
SESSION_MAX_ROWS=100
SESSION_CLEANUP_INTERVAL_MINUTES=30

# analysis
ANALYSIS_REVIEW_MAX_CHARS=1000
ANALYSIS_NGRAM_MAX_N=3
ANALYSIS_NGRAM_TOP_K=100
ANALYSIS_EXTRACTION_SAMPLE_SIZE=20
ANALYSIS_EXTRACTION_SAMPLE_CHARS=300
ANALYSIS_SCORING_RETRIES=1
ANALYSIS_ESTIMATED_SECONDS_PER_REVIEW=2.5

# rate limiting configuration (requests per minute)
RATE_LIMIT_UPLOAD=5
RATE_LIMIT_EXTRACT=10
RATE_LIMIT_ANALYZE=5
RATE_LIMIT_READ=120
RATE_LIMIT_HEALTH=60

# database configuration
DATABASE_PATH=./data/reviews-analysis-database.db

# frontend
FRONTEND_PORT=80

# LLM
LLM_PARALLEL=4
LLM_THREADS=4
